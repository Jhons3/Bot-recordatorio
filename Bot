def enviar_brevo(cliente, fecha_vencimiento):
    if not BREVO_API_KEY:
        logger.warning("Brevo no configurado")
        return False

    try:
        if not validar_email(cliente.get('email', '')):
            logger.warning(f"Email inválido: {cliente['nombre']}")
            return False

        html_content = crear_html_email(cliente, fecha_vencimiento)

        headers = {
            'api-key': BREVO_API_KEY,
            'Content-Type': 'application/json'
        }

        data = {
            'sender': {'name': BREVO_FROM_NAME, 'email': BREVO_FROM_EMAIL},
            'to': [{'email': cliente['email'], 'name': cliente['nombre']}],
            'subject': f"Recordatorio: Cuota de su vehículo {cliente['vehiculo']}",
            'htmlContent': html_content
        }

        response = requests.post(BREVO_API_URL, headers=headers, data=json.dumps(data), timeout=10)

        if response.status_code == 201:
            logger.info(f" Email enviado: {cliente['nombre']} ({cliente['email']})")
            return True
        else:
            logger.error(f" Error Brevo HTTP {response.status_code}: {response.text}")
            return False

    except requests.exceptions.Timeout:
        logger.error(f" Timeout email: {cliente['nombre']}")
        return False
    except Exception as e:
        logger.error(f" Error Brevo: {str(e)}")
        return False

# ==================== FUNCIÓN DE ENVÍO WHATSAPP ====================

def enviar_whatsapp(cliente, fecha_vencimiento):
    if not all([TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_NUMBER, TWILIO_TEMPLATE_SID]):
        logger.warning(" Twilio incompleto en variables de entorno")
        return False

    try:
        es_valido, numero_limpio = validar_whatsapp(cliente.get('whatsapp', ''))

        if not es_valido:
            logger.warning(f" WhatsApp inválido: {cliente['nombre']}")
            return False

        client = Client(TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN)

        variables = {
            "1": str(cliente['nombre']),
            "2": str(cliente['cedula']),
            "3": str(cliente['vehiculo']),
            "4": f"${float(cliente['cuota']):.2f}",
            "5": str(fecha_vencimiento)
        }

        message = client.messages.create(
            from_=TWILIO_WHATSAPP_NUMBER,
            to=f"whatsapp:{numero_limpio}",
            content_sid=TWILIO_TEMPLATE_SID,
            content_variables=json.dumps(variables)
        )

        logger.info(f" WhatsApp enviado: {cliente['nombre']} ({numero_limpio}) - SID: {message.sid}")
        return True

    except Exception as e:
        logger.error(f" Error WhatsApp: {str(e)}")
        return False

# ==================== FUNCIÓN PRINCIPAL DE ENVÍO ====================

def enviar_recordatorios(grupo):
    """
    grupo: 14 (para clientes días 15-16) o 28 (para clientes días 29-30)
    """
    logger.info("=" * 70)
    logger.info(f"Iniciando envío - Grupo {grupo}")
    logger.info("=" * 70)

    todos_clientes = cargar_clientes_desde_excel()
    if not todos_clientes:
        logger.error("No hay clientes cargados")
        return

    clientes = filtrar_clientes_por_grupo(todos_clientes, grupo)
    if not clientes:
        logger.info(f"No hay clientes para el grupo {grupo}")
        return

    _, mes, año = obtener_dia_ecuador()

    exitosos_whatsapp = 0
    exitosos_email    = 0
    fallidos_whatsapp = 0
    fallidos_email    = 0

    for idx, cliente in enumerate(clientes, 1):
        logger.info(f"\nCliente {idx}/{len(clientes)}: {cliente['nombre']}")

        fecha_vencimiento = formatear_fecha_vencimiento(cliente['dia_pago'], mes, año)

        if cliente.get('whatsapp'):
            if enviar_whatsapp(cliente, fecha_vencimiento):
                exitosos_whatsapp += 1
            else:
                fallidos_whatsapp += 1

        if cliente.get('email'):
            if enviar_brevo(cliente, fecha_vencimiento):
                exitosos_email += 1
            else:
                fallidos_email += 1

        if idx < len(clientes):
            time.sleep(2)

    logger.info("\n" + "=" * 70)
    logger.info("RESUMEN")
    logger.info("=" * 70)
    logger.info(f"Total procesados: {len(clientes)}")
    logger.info(f"WhatsApp → Exitosos: {exitosos_whatsapp} | Fallidos: {fallidos_whatsapp}")
    logger.info(f"Email    → Exitosos: {exitosos_email} | Fallidos: {fallidos_email}")
    logger.info(f"TOTAL enviados: {exitosos_whatsapp + exitosos_email}")
    logger.info("=" * 70)

# ==================== EJECUCIÓN PRINCIPAL ====================

def main():
    """
    Uso:
      python bot_recordatorios.py          → detecta el día automáticamente
      python bot_recordatorios.py 14       → fuerza grupo 14 (días 15-16)
      python bot_recordatorios.py 28       → fuerza grupo 28 (días 29-30)
    """
    logger.info("=" * 70)
    logger.info("BOT DE RECORDATORIOS DE PAGOS v5.0.0")
    logger.info("=" * 70)

    # ── Verificar credenciales ──────────────────────────────────────────────
    errores = []
    if not all([TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_NUMBER, TWILIO_TEMPLATE_SID]):
        errores.append("Twilio: faltan variables de entorno")
    if not BREVO_API_KEY:
        errores.append("Brevo: falta BREVO_API_KEY")
    if not os.path.exists(ARCHIVO_CLIENTES):
        errores.append(f"Excel no encontrado: {ARCHIVO_CLIENTES}")

    if errores:
        for e in errores:
            logger.error(f" {e}")
        sys.exit(1)

    logger.info(" Twilio configurado")
    logger.info(" Brevo configurado")
    logger.info(" Excel encontrado")

    # ── Determinar qué grupo enviar ─────────────────────────────────────────
    # Argumento manual (útil para pruebas o re-envíos)
    if len(sys.argv) > 1:
        try:
            grupo_forzado = int(sys.argv[1])
            if grupo_forzado not in [14, 28]:
                logger.error("Argumento inválido. Usa 14 o 28.")
                sys.exit(1)
            logger.info(f"Grupo forzado por argumento: {grupo_forzado}")
            enviar_recordatorios(grupo_forzado)
            return
        except ValueError:
            logger.error("Argumento inválido. Debe ser 14 o 28.")
            sys.exit(1)

    # Detección automática por día de Ecuador
    dia_hoy, mes_hoy, año_hoy = obtener_dia_ecuador()
    logger.info(f"Día Ecuador: {dia_hoy}/{mes_hoy}/{año_hoy}")

    if dia_hoy == 14:
        logger.info("→ Ejecutando grupo 14 (clientes días 15-16)")
        enviar_recordatorios(14)
    elif dia_hoy == 28:
        logger.info("→ Ejecutando grupo 28 (clientes días 29-30)")
        enviar_recordatorios(28)
    else:
        logger.info(f"  Hoy es día {dia_hoy}. No hay envíos programados para hoy.")
        logger.info("   Los envíos se realizan los días 14 y 28 de cada mes.")


if __name__ == "__main__":
    main()

