import json
import os
import logging
import requests
import pandas as pd
from datetime import datetime, timezone, timedelta
from twilio.rest import Client
from dotenv import load_dotenv

# ==================== CONFIGURACIÓN DE LOGGING ====================

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('bot_recordatorios.log', encoding='utf-8'),
        logging.StreamHandler(sys.stdout)
    ]
)

logger = logging.getLogger(__name__)

# ==================== CONFIGURACIÓN ====================

load_dotenv()

# Configuración de Twilio
TWILIO_ACCOUNT_SID       = os.getenv('TWILIO_ACCOUNT_SID')
TWILIO_AUTH_TOKEN        = os.getenv('TWILIO_AUTH_TOKEN')
TWILIO_WHATSAPP_NUMBER   = os.getenv('TWILIO_WHATSAPP_NUMBER')
TWILIO_TEMPLATE_SID      = os.getenv('TWILIO_TEMPLATE_SID')

# Configuración de Brevo
BREVO_API_KEY    = os.getenv('BREVO_API_KEY')
BREVO_FROM_EMAIL = os.getenv('BREVO_FROM_EMAIL')
BREVO_FROM_NAME  = os.getenv('BREVO_FROM_NAME', 'BUSINESS MOTORS BUSIMOTT CIA LTDA')
BREVO_API_URL    = 'https://api.brevo.com/v3/smtp/email'

# Ruta del archivo de clientes
ARCHIVO_CLIENTES = 'clientes.xlsx'

# Zona horaria Ecuador (UTC-5) — GitHub Actions siempre corre en UTC
ZONA_ECUADOR = timezone(timedelta(hours=-5))

# Constantes de días de pago
DIAS_GRUPO_14 = [15, 16]
DIAS_GRUPO_28 = [29, 30]

# ==================== FUNCIONES DE VALIDACIÓN ====================

def validar_email(email):
    if not email or not isinstance(email, str):
        return False
    email = email.strip()
    if '@' not in email:
        return False
    partes = email.split('@')
    if len(partes) != 2:
        return False
    if '.' not in partes[1]:
        return False
    if not partes[0] or not partes[1]:
        return False
    return True


def validar_whatsapp(numero):
    if not numero:
        return False, ""
    try:
        numero = str(numero).strip()
        numero_limpio = ''.join(c for c in numero if c.isdigit() or c == '+')
        if numero_limpio and not numero_limpio.startswith('+'):
            numero_limpio = '+' + numero_limpio
        if len(numero_limpio) < 10:
            return False, numero_limpio
        if not numero_limpio[1:].isdigit():
            return False, numero_limpio
        return True, numero_limpio
    except Exception as e:
        logger.error(f"Error validando WhatsApp: {str(e)}")
        return False, ""

# ==================== FUNCIONES DE FECHA ====================

def obtener_dia_ecuador():
    """
    Retorna el día actual en zona horaria Ecuador (UTC-5).
    CRÍTICO: GitHub Actions corre en UTC. Sin esto, a las 11pm UTC
    el bot pensaría que es el día siguiente en Ecuador.
    """
    ahora_ecuador = datetime.now(ZONA_ECUADOR)
    logger.info(f"Fecha/hora UTC:     {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S')}")
    logger.info(f"Fecha/hora Ecuador: {ahora_ecuador.strftime('%Y-%m-%d %H:%M:%S')}")
    return ahora_ecuador.day, ahora_ecuador.month, ahora_ecuador.year


def dias_en_mes(mes, año):
    dias = {
        1: 31, 2: 28, 3: 31, 4: 30, 5: 31, 6: 30,
        7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31
    }
    if año % 4 == 0 and (año % 100 != 0 or año % 400 == 0):
        dias[2] = 29
    return dias[mes]


def formatear_fecha_vencimiento(dia, mes, año):
    max_dias = dias_en_mes(mes, año)
    if dia > max_dias:
        dia = max_dias
    fecha = datetime(año, mes, dia)
    return fecha.strftime('%d/%m/%Y')

# ==================== FUNCIONES DE CARGA DE DATOS ====================

def cargar_clientes_desde_excel():
    try:
        if not os.path.exists(ARCHIVO_CLIENTES):
            logger.error(f"No se encontró el archivo: {ARCHIVO_CLIENTES}")
            return []

        logger.info(f"Cargando clientes desde: {ARCHIVO_CLIENTES}")
        df = pd.read_excel(ARCHIVO_CLIENTES)
        logger.info(f"Registros leídos: {len(df)}")

        columnas_requeridas = ['nombre', 'cedula', 'whatsapp', 'email', 'vehiculo', 'cuota', 'dia_pago']
        columnas_faltantes = [col for col in columnas_requeridas if col not in df.columns]

        if columnas_faltantes:
            logger.error(f"Faltan columnas: {', '.join(columnas_faltantes)}")
            return []

        registros_iniciales = len(df)

        df = df.dropna(subset=['nombre', 'cedula', 'dia_pago'])
        df['nombre']   = df['nombre'].astype(str).str.strip()
        df['cedula']   = df['cedula'].astype(str).str.strip()
        df['email']    = df['email'].astype(str).str.strip()
        df['vehiculo'] = df['vehiculo'].astype(str).str.strip()
        df['whatsapp'] = df['whatsapp'].astype(str).str.strip()

        try:
            df['dia_pago'] = df['dia_pago'].astype(int)
        except ValueError as e:
            logger.error(f"Error en dia_pago: {str(e)}")
            return []

        df = df[df['dia_pago'].between(1, 31)]
        df = df[df['cuota'] > 0]

        clientes = df.to_dict('records')
        registros_descartados = registros_iniciales - len(clientes)

        logger.info(f"Clientes cargados: {len(clientes)}")
        if registros_descartados > 0:
            logger.warning(f"Registros descartados: {registros_descartados}")

        return clientes

    except Exception as e:
        logger.error(f"Error cargando Excel: {str(e)}")
        return []


def filtrar_clientes_por_grupo(clientes, grupo):
    """
    grupo=14 → clientes con dia_pago en [15, 16]
    grupo=28 → clientes con dia_pago en [29, 30]
    """
    if grupo == 14:
        dias_filtro = DIAS_GRUPO_14
        nombre_grupo = "15-16"
    elif grupo == 28:
        dias_filtro = DIAS_GRUPO_28
        nombre_grupo = "29-30"
    else:
        logger.error(f"Grupo inválido: {grupo}")
        return []

    clientes_filtrados = [c for c in clientes if c['dia_pago'] in dias_filtro]
    logger.info(f"Clientes grupo {nombre_grupo}: {len(clientes_filtrados)}")
    return clientes_filtrados

# ==================== FUNCIÓN DE ENVÍO EMAIL (BREVO) ====================

